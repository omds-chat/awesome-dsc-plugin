{
  "name": "awesome-dsc-plugin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "dsc 社区插件合集: 按分发规范 v2 收录、签名并分发插件",
  "license": "Apache-2.0",
  "homepage": "https://omdsc-dev.github.io/awesome-dsc-plugin/",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsc-dev/awesome-dsc-plugin.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "type": "node scripts/check-syntax.mjs",
    "verify": "node scripts/verify-catalog.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs --dir dist/pages",
    "build": "node scripts/build-from-catalog.mjs --catalog catalog --certs certs --site site/dist --out dist/pages",
    "build:site": "pnpm --dir site build",
    "verify:consistency": "node scripts/verify-catalog-consistency.mjs --dir dist/pages",
    "report:anomalies": "node scripts/report-build-anomalies.mjs --anomalies dist/pages/catalog/anomalies.json"
  },
  "keywords": [
    "dsc",
    "dsc-plugin",
    "plugin-collection",
    "openssl",
    "pki"
  ]
}
